package-as: Goblinomics
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

move-folders:
  Goblinomics/Modules/Vault: Goblinomics_Vault
  Goblinomics/Modules/Ledger: Goblinomics_Ledger
  Goblinomics/Modules/Gatherer: Goblinomics_Gatherer
  Goblinomics/Modules/Workshop: Goblinomics_Workshop
  Goblinomics/Modules/Insights: Goblinomics_Insights
  Goblinomics/Modules/Link: Goblinomics_Link
  Goblinomics/Modules/Import: Goblinomics_Import
  Goblinomics/Connectors/TSM: Goblinomics_Connector_TSM
  Goblinomics/Connectors/Auctionator: Goblinomics_Connector_Auctionator
  Goblinomics/Connectors/CraftSim: Goblinomics_Connector_CraftSim
  Goblinomics/Connectors/GatherMate2: Goblinomics_Connector_GatherMate2

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .editorconfig
  - .luacheckrc
  - .busted
  - spec
  - tools
  - README.md
